# Copy to terraform.tfvars (git-ignored) and fill in. Everything not listed keeps its default
# from variables.tf.
project_id = "my-gcp-project"

# Your own public address (curl -4 ifconfig.me), as a /32. 0.0.0.0/0 is rejected.
allowed_ssh_cidrs = ["203.0.113.4/32"]

# Who may open the console. Leave the default (anyone with the address and a gateway token)
# or list your viewers' addresses.
# allowed_http_cidrs = ["203.0.113.4/32", "198.51.100.0/24"]

# region = "us-central1"
# zone   = "us-central1-a"
# machine_type = "e2-standard-8"
# boot_disk_gb = 100
