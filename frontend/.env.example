# Copy to .env.local (git-ignored) to override. Everything is optional.

# The supported setup is same-origin: the Docker image (nginx) and `npm run dev` (Vite, see below) both
# proxy /graphql, /api, and /ml/segment, so this stays unset. It exists for a deployment that puts the app
# on another origin behind an edge that adds CORS: the gateway sends no CORS headers, so a browser blocks
# the JSON and Authorization-bearing requests to a bare cross-origin base.
#VITE_API_BASE_URL=http://localhost:8080


# Where the Vite dev server proxies /graphql, /api, and /ml/segment (default: the Compose gateway, which routes /ml/segment).
#VITE_DEV_API_TARGET=http://localhost:8080
