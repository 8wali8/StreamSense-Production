# Copy to .env.local (git-ignored) to override. Everything is optional.

# Origin of the API gateway when the app is NOT served behind the same host as /graphql, /api and /ml/segment.
# Leave unset for the Docker image (nginx proxies) and for `npm run dev` (Vite proxies, see below).
#VITE_API_BASE_URL=http://localhost:8080


# Where the Vite dev server proxies /graphql, /api, and /ml/segment (default: the Compose gateway, which routes /ml/segment).
#VITE_DEV_API_TARGET=http://localhost:8080
