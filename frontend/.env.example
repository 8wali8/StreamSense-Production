# Copy to .env.local (git-ignored) to override. Everything is optional.

# The supported setup is same-origin: the Docker image (nginx) and `npm run dev` (Vite, see below) both
# proxy /graphql, /api, and /ml, so these two stay unset. They exist for a deployment that puts the app
# on another origin behind an edge that adds CORS: neither the gateway nor ml-engine sends CORS headers,
# so a browser blocks the JSON and Authorization-bearing requests to a bare cross-origin base.
#VITE_API_BASE_URL=http://localhost:8080
# ml-engine origin for /ml calls in that setup; the gateway does not route /ml.
#VITE_ML_BASE_URL=http://localhost:8000

# Where the Vite dev server proxies /graphql and /api (default: the Compose gateway) and /ml (default: the Compose ml-engine).
#VITE_DEV_API_TARGET=http://localhost:8080
#VITE_DEV_ML_TARGET=http://localhost:8000
