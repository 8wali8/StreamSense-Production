# Copy to .env.local (git-ignored) to override. Everything is optional.

# Origin of the API gateway when the app is NOT served behind the same host as /graphql, /api and /ml.
# Leave unset for the Docker image (nginx proxies) and for `npm run dev` (Vite proxies, see below).
#VITE_API_BASE_URL=http://localhost:8080

# Where the Vite dev server proxies /graphql and /api (default: the Compose gateway) and /ml (default: the Compose ml-engine).
#VITE_DEV_API_TARGET=http://localhost:8080
#VITE_DEV_ML_TARGET=http://localhost:8000
