{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranscriptSegmentEvent",
  "type": "object",
  "required": [
    "segmentId",
    "streamer",
    "text",
    "startedAt",
    "endedAt",
    "modelVersion",
    "source",
    "channelLogin",
    "streamSessionId",
    "videoTimestampMs",
    "transcriptSequence",
    "captureWorkerId"
  ],
  "properties": {
    "segmentId": { "type": "string" },
    "streamer": { "type": "string" },
    "text": { "type": "string", "maxLength": 4000 },
    "startedAt": { "type": "integer" },
    "endedAt": { "type": "integer" },
    "language": { "type": ["string", "null"] },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "modelVersion": { "type": "string" },
    "source": { "const": "TWITCH" },
    "channelLogin": { "type": "string" },
    "streamSessionId": { "type": "string" },
    "twitchStreamId": { "type": ["string", "null"] },
    "videoTimestampMs": { "type": "integer" },
    "transcriptSequence": { "type": "integer" },
    "captureWorkerId": { "type": "string" }
  }
}
