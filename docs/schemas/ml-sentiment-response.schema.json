{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamsense.dev/schemas/ml-sentiment-response.schema.json",
  "title": "MlSentimentResponse",
  "type": "object",
  "required": [
    "label",
    "score",
    "modelVersion"
  ],
  "properties": {
    "label": {
      "type": "string",
      "enum": [
        "POSITIVE",
        "NEUTRAL",
        "NEGATIVE"
      ]
    },
    "score": {
      "type": "number",
      "description": "Sentiment polarity score in range [-1.0, 1.0]"
    },
    "modelVersion": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
