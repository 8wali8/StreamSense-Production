{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamsense.dev/schemas/ml-sentiment-request.schema.json",
  "title": "MlSentimentRequest",
  "type": "object",
  "required": [
    "eventId",
    "streamer",
    "user",
    "message",
    "timestamp"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Original chat event ID"
    },
    "streamer": {
      "type": "string"
    },
    "user": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "timestamp": {
      "type": "integer",
      "description": "Chat message timestamp (epoch millis)"
    }
  },
  "additionalProperties": false
}
