type SponsorDetectionEvent {
  detectionEventId: ID!
  sourceFrameId: ID!
  streamer: String!
  frameRef: String!
  frameSequence: Float!
  capturedAt: Float!
  processedAt: Float!
  sponsor: String!
  confidence: Float!
  modelVersion: String!
  x: Float!
  y: Float!
  width: Float!
  height: Float!
  source: String
  channelLogin: String
  streamSessionId: String
  twitchStreamId: String
  videoTimestampMs: Float
  # What happened to the frame: DETECTED, NOT_DETECTED (looked, not found), NO_LOGO (nothing to look for),
  # or UNAVAILABLE (could not be examined). Null on events from before outcomes.
  outcome: String
  dealId: ID
  logoId: ID
}
