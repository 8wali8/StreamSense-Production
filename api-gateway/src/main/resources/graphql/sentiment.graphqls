type SentimentAnalysisEvent {
  sentimentEventId: ID!
  sourceEventId: ID!
  streamer: String!
  user: String!
  message: String!
  chatTimestamp: Float!
  processedAt: Float!
  label: String!
  score: Float!
  modelVersion: String!
  sponsorRelevant: Boolean!
  matchedSponsor: String
  matchedTerms: [String!]!
  relevanceScore: Float!
  relevanceReason: String
  relevanceVersion: String
}

type TranscriptSegmentEvent {
  segmentId: ID!
  streamer: String!
  text: String!
  startedAt: Float!
  endedAt: Float!
  language: String
  confidence: Float
  modelVersion: String!
  source: String!
  channelLogin: String
  streamSessionId: String!
  twitchStreamId: String
  videoTimestampMs: Float!
  transcriptSequence: Float!
  captureWorkerId: String
}

type TranscriptSentimentEvent {
  sentimentEventId: ID!
  segmentId: ID!
  streamer: String!
  text: String!
  segmentStartedAt: Float!
  segmentEndedAt: Float!
  processedAt: Float!
  label: String!
  score: Float!
  modelVersion: String!
  transcriptModelVersion: String!
  streamSessionId: String!
  transcriptSequence: Float!
  sponsorRelevant: Boolean!
  matchedSponsor: String
  matchedTerms: [String!]!
  relevanceScore: Float!
  relevanceReason: String
  relevanceVersion: String
}
