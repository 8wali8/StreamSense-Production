type Query {
  health: String!
  recentSentiment(streamer: String!, limit: Int!): [SentimentAnalysisEvent!]!
  sponsorDetections(streamer: String!, limit: Int!): [SponsorDetectionEvent!]!
}

type Subscription {
  onChatMessage(streamer: String!): ChatMessageEvent!
  onSentiment(streamer: String!): SentimentAnalysisEvent!
  onSponsorDetection(streamer: String!): SponsorDetectionEvent!
}

type ChatMessageEvent {
  eventId: ID!
  streamer: String!
  user: String!
  message: String!
  timestamp: Float!  # GraphQL Float handles JS number; we'll treat it as epoch millis
}

type SentimentAnalysisEvent {
  sentimentEventId: ID!
  sourceEventId: ID!
  streamer: String!
  user: String!
  message: String!
  chatTimestamp: Float!
  processedAt: Float!
  label: String!
  score: Float!
  modelVersion: String!
}

type SponsorDetectionEvent {
  detectionEventId: ID!
  sourceFrameId: ID!
  streamer: String!
  frameRef: String!
  frameSequence: Float!
  capturedAt: Float!
  processedAt: Float!
  sponsor: String!
  confidence: Float!
  modelVersion: String!
  x: Float!
  y: Float!
  width: Float!
  height: Float!
}
