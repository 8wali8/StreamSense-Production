type StreamMetricsSummary {
  streamer: String!
  streamSessionId: String
  windowMinutes: Int!
  bucketSizeSeconds: Int!
  windowStart: Float!
  windowEnd: Float!
  chat: ChatMetrics!
  chatSentiment: SentimentMetricSummary!
  transcriptSentiment: SentimentMetricSummary!
  sponsorExposure: SponsorExposureSummary!
  engagement: EngagementMetrics!
  risk: BrandSafetyMetrics!
  dataQuality: AnalyticsDataQuality!
}

type ChatMetrics {
  totalMessages: Float!
  messagesPerMinute: Float!
  uniqueChatters: Float!
  peakMessagesPerMinute: Float!
}

type SentimentMetricSummary {
  positive: Float!
  neutral: Float!
  negative: Float!
  averageScore: Float
  negativeRatio: Float
}

type SponsorExposureSummary {
  totalDetections: Float!
  acceptedDetections: Float!
  estimatedExposureMs: Float!
  topSponsors: [SponsorExposureMetric!]!
}

type SponsorExposureMetric {
  sponsor: String!
  detectionCount: Float!
  acceptedDetectionCount: Float!
  estimatedExposureMs: Float!
  averageConfidence: Float
  maxConfidence: Float
  fallbackDetectionCount: Float!
  lowConfidenceDetectionCount: Float!
  # Frames looked at for the logo (found or not), and frames not looked at because the deal had none.
  examinedDetectionCount: Float!
  noLogoDetectionCount: Float!
}

type EngagementMetrics {
  spikeCount: Float!
  latestSpikeAt: Float
}

type BrandSafetyMetrics {
  level: String!
  score: Float
  factors: [RiskFactor!]!
}

type RiskFactor {
  name: String!
  value: Float!
  weight: Float!
}

type AnalyticsDataQuality {
  lowData: Boolean!
  latestEventAt: Float
  aggregationLagMs: Float
}

type StreamMetricBucket {
  bucketStart: Float!
  bucketEnd: Float!
  chatMessageCount: Float!
  uniqueChatters: Float!
  chatAverageScore: Float
  chatNegativeRatio: Float
  transcriptAverageScore: Float
  transcriptNegativeRatio: Float
  sponsorDetectionCount: Float!
  estimatedSponsorExposureMs: Float!
  engagementSpike: Boolean!
  negativeSpike: Boolean!
}

# One stream. source is HELIX (seen live by the Twitch poller), CAPTURE (derived from captured
# events, what a replay alias produces), or VOD (imported from a Twitch recording). endedAt is null and live is true while the stream is on.
type StreamSession {
  id: ID!
  streamer: String!
  source: String!
  twitchStreamId: String
  streamSessionId: String
  channelLogin: String
  title: String
  category: String
  startedAt: Float!
  endedAt: Float
  live: Boolean!
  durationMs: Float!
  peakViewers: Int
  averageViewers: Float
  viewerSamples: Int!
  # The Twitch recording the session was imported from (source VOD, or a Helix session imported afterwards).
  vodId: String
}

# What the sponsor's exposure would have cost to buy. Null money fields mean no viewer samples yet.
# The rates and basis are always present so the reader can see the assumptions.
type SessionValue {
  logoValue: Float
  hostReadValue: Float
  mediaValue: Float
  weightedLogoViewerMinutes: Float
  averageProminence: Float
  cpmPer30sEquivalent: Float!
  hostReadRatePer1000: Float!
  basis: String!
}

type DirectResponse {
  chatCommand: String
  commandUses: Int!
  commandUsers: Int!
  trackedLinkHost: String
  linkPosts: Int!
}

type SessionSummary {
  session: StreamSession!
  # The deal the session fell inside, when there is one; its terms filled what the request left out.
  dealId: ID
  sponsor: String
  onScreenMs: Float!
  onScreenShare: Float
  mentions: Int!
  chatMentions: Int!
  voiceMentions: Int!
  mentionSentiment: Float
  mentionPositiveShare: Float
  mentionNegativeShare: Float
  averageViewers: Float
  peakViewers: Int
  risk: BrandSafetyMetrics!
  chat: ChatMetrics!
  chatSentiment: SentimentMetricSummary!
  transcriptSentiment: SentimentMetricSummary!
  engagement: EngagementMetrics!
  value: SessionValue!
  response: DirectResponse!
  # Whether the frames were examined for the sponsor's logo; when they were not, logoValue and mediaValue are null.
  onScreenTracking: OnScreenTracking
}

# ON: every frame examined. PARTIAL: some could not be (unavailableMs says how much of the stream).
# UNAVAILABLE: none could. OFF: the deal had no logo, nothing was looked for. NO_FRAMES: no video captured.
type OnScreenTracking {
  state: String!
  examinedFrames: Int!
  unavailableFrames: Int!
  noLogoFrames: Int!
  unavailableMs: Float!
}

# A run of consecutive detections of one sponsor. offsetMs is from the session start, for the VOD.
type ExposureSegment {
  sponsor: String!
  startedAt: Float!
  endedAt: Float!
  offsetMs: Float!
  durationMs: Float!
  videoTimestampMs: Float
  detections: Int!
  peakConfidence: Float!
}

type VoiceMention {
  sentimentEventId: ID!
  at: Float!
  offsetMs: Float!
  label: String!
  score: Float!
  text: String!
}

# Sponsor-relevant chat lines grouped per minute.
type ChatMoment {
  at: Float!
  offsetMs: Float!
  count: Int!
  positiveShare: Float!
  negativeShare: Float!
  averageScore: Float!
  sample: String
  user: String
}

type RiskSpike {
  at: Float!
  offsetMs: Float!
  chatNegativeRatio: Float
  chatMessageCount: Float!
}

type HighlightMoment {
  kind: String!
  at: Float!
  offsetMs: Float!
  title: String!
  detail: String!
  score: Float!
}

type SponsorMoments {
  session: StreamSession!
  sponsor: String
  segments: [ExposureSegment!]!
  voiceMentions: [VoiceMention!]!
  chatMoments: [ChatMoment!]!
  riskSpikes: [RiskSpike!]!
  best: HighlightMoment
  weakest: HighlightMoment
}

# One sponsorship deal. fee is what the streamer is paid (private to them); the rates price the
# exposure; trackedLinkHost and chatCommand are what chat is counted for. active while the dates cover now.
type Deal {
  id: ID!
  streamer: String!
  sponsor: String!
  startsAt: Float!
  endsAt: Float
  promisedStreams: Int
  fee: Float
  currency: String!
  cpmPer30sEquivalent: Float!
  hostReadRatePer1000: Float!
  trackedLink: String
  trackedLinkHost: String
  chatCommand: String
  channelPointReward: String
  active: Boolean!
  # The read-only share token when the deal is shared; private to the streamer like the fee.
  shareToken: String
  createdAt: Float!
  # The sponsor's logos on-screen detection looks for, oldest upload first; empty means tracking is off.
  logos: [DealLogo!]!
}

# One logo on a deal. The image itself is read from the REST route
# GET /api/analytics/deals/{id}/logos/{logoId}, so a share link (GraphQL only) sees the facts, not the bytes.
type DealLogo {
  id: ID!
  contentType: String!
  width: Int!
  height: Int!
  sizeBytes: Int!
  uploadedAt: Float!
}

# Totals over the streams inside a deal's dates. Money is null until a stream had viewer samples;
# mentionSentiment is weighted by mention count.
type DealTotals {
  streams: Int!
  liveStreams: Int!
  streamedMs: Float!
  onScreenMs: Float!
  onScreenShare: Float
  mentions: Int!
  chatMentions: Int!
  voiceMentions: Int!
  mentionSentiment: Float
  averageViewers: Float
  logoValue: Float
  hostReadValue: Float
  mediaValue: Float
  commandUses: Int!
  linkPosts: Int!
}

type DealSummary {
  deal: Deal!
  totals: DealTotals!
  # Newest first.
  sessions: [SessionSummary!]!
}
