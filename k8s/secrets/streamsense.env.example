# Copy to k8s/secrets/streamsense.env (git-ignored) and change every value before `kubectl apply -k k8s`.
# kustomize turns this file into the `streamsense-secrets` Secret; manifests reference the keys by name.
POSTGRES_PASSWORD=streamsense
STREAMSENSE_FRAME_STORAGE_ACCESS_KEY=streamsense
STREAMSENSE_FRAME_STORAGE_SECRET_KEY=streamsense
GRAFANA_ADMIN_PASSWORD=admin
# Required only when STREAMSENSE_GATEWAY_AUTH_ENABLED=true; must be at least 32 bytes.
STREAMSENSE_GATEWAY_AUTH_HMAC_SECRET=
