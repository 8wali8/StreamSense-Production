# Template for k8s/secrets/streamsense.env (git-ignored). `make secrets` writes that file with random
# values (the same ones it puts under secrets/ for Compose). To create it by hand, copy this file and
# replace every placeholder. kustomize turns it into the streamsense-secrets-<hash> Secret and rewrites
# every secretKeyRef to the hashed name, so changing a value and re-applying rolls the pods that use it.
POSTGRES_PASSWORD=replace-with-a-random-value
STREAMSENSE_FRAME_STORAGE_ACCESS_KEY=replace-with-a-random-value
STREAMSENSE_FRAME_STORAGE_SECRET_KEY=replace-with-a-random-value
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-value
# Required only when STREAMSENSE_GATEWAY_AUTH_ENABLED=true; must be at least 32 bytes.
STREAMSENSE_GATEWAY_AUTH_HMAC_SECRET=replace-with-at-least-32-random-bytes
