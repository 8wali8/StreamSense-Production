# Twitch settings for the hosted demo. Copy to /etc/streamsense/twitch.env on the VM (root only,
# 0600; deploy.sh enforces the mode) and fill in the values. deploy.sh passes the file to
# `docker compose --env-file`, which is what docker-compose.yml's ${TWITCH_*} placeholders read.
# Any variable the base file interpolates may be set here; the ones below are the ones a live
# capture needs. Never commit the filled-in copy.

# Credentials. The chat token is an IRC OAuth token ("oauth:..."); the video token is an OAuth
# token for the Twitch GraphQL/API used to resolve stream playlists (may be the same account).
# No client id: the stack uses Twitch's public web client id for its GraphQL calls and the
# Compose file passes none through.
TWITCH_CHAT_USERNAME=
TWITCH_CHAT_OAUTH_TOKEN=
TWITCH_VIDEO_OAUTH_TOKEN=

# Channels to watch at start-up (comma separated). The console's streamer field switches them at runtime.
TWITCH_CHANNELS=
TWITCH_VIDEO_CHANNELS=

# Capture toggles for a live demo.
STREAMSENSE_TWITCH_CHAT_ENABLED=true
STREAMSENSE_TWITCH_VIDEO_ENABLED=true
STREAMSENSE_TWITCH_TRANSCRIPT_ENABLED=true

# Optional tuning; the defaults in docker-compose.yml apply when unset.
# TWITCH_VIDEO_QUALITY=best
# TWITCH_VIDEO_SAMPLE_INTERVAL_SECONDS=10
# TWITCH_TRANSCRIPT_SEGMENT_SECONDS=10
# TWITCH_TRANSCRIPT_LANGUAGE=en

# Which published image to run: "main" or a commit SHA from the publish-images CI job. The
# deploy script reads this line (a value in its own environment wins) and checks out the same
# ref, so the config-repo the config-server serves matches the images.
# STREAMSENSE_IMAGE_TAG=main
