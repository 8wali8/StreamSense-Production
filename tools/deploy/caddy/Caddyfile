# The edge of the hosted demo: Caddy in front of the console's nginx (docker-compose.prod.yml).
#
# STREAMSENSE_DOMAIN set (for example streamsense.dev): Caddy serves that name on 443 with a
# Let's Encrypt certificate it obtains and renews on its own (HTTP-01 challenge, so the DNS A
# record must point at this VM before the first start), and redirects port 80 to HTTPS.
# The .dev top-level domain is HSTS-preloaded in every browser, so HTTPS is the only way a
# .dev name can be served at all.
#
# STREAMSENSE_DOMAIN unset: docker-compose.prod.yml passes ":80" instead, and Caddy serves plain
# HTTP on port 80 for the VM's address, as before the domain. (The substitution happens in the
# Compose file rather than as a Caddyfile default because Caddy treats an empty variable as set.)
#
# Everything is proxied to the frontend container, whose nginx serves the console and forwards
# /graphql (WebSocket included), /api/, and /ml/segment to the gateway. Caddy adds
# X-Forwarded-For and X-Forwarded-Proto; nginx appends its own hop, which is why the gateway
# trusts two proxy hops in the overlay.

{
	# Caddy's own admin API is not needed and stays off.
	admin off
}

{$STREAMSENSE_DOMAIN} {
	encode zstd gzip

	reverse_proxy frontend:8080 {
		# GraphQL subscriptions are long-lived WebSocket connections; never time them out here.
		transport http {
			response_header_timeout 0
		}
	}
}

# Liveness for the Compose healthcheck: a loopback-only listener inside the container that
# answers the same way whichever site address is configured above. (Probing port 80 with a bare
# 127.0.0.1 host does not reach the domain site, so the check failed in HTTPS mode.)
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz "ok" 200
}
